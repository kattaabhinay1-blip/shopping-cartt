# Initialize data lists as specified
product_list = [
    {"name": "Laptop", "price": 55000.0},
    {"name": "Headphones", "price": 2500.0},
    {"name": "Mouse", "price": 800.0},
]
cart_list = []
user_list = ["abhi", "vinay", "aman"]
order_list = []


# ==========================================
# ADMIN SECTION
# ==========================================
def view_products_admin():
    """View all products and their details."""
    if not product_list:
        print("\n[!] No products available.")
        return
    print("\n--- Available Products ---")
    for i in range(len(product_list)):
        prod = product_list[i]
        print(f"[{i + 1}] Name: {prod['name']} | Price: ₹{prod['price']:.2f}")


def add_product():
    """Add a new product using append()."""
    name = input("Enter product name: ").strip()
    try:
        price = float(input("Enter product price (in ₹): "))
        product_list.append({"name": name, "price": price})
        print(f"--> '{name}' added successfully at ₹{price:.2f}.")
    except ValueError:
        print("[!] Invalid price. Please enter a valid number.")


def update_product():
    """Update product details using list indexing."""
    view_products_admin()
    if not product_list:
        return

    try:
        idx = int(input("Enter product number to update: ")) - 1
        if 0 <= idx < len(product_list):
            new_name = input(
                f"Enter new name (current: {product_list[idx]['name']}): "
            ).strip()
            new_price = float(
                input(f"Enter new price in ₹ (current: ₹{product_list[idx]['price']:.2f}): ")
            )
            # Update via indexing
            product_list[idx] = {
                "name": new_name if new_name else product_list[idx]["name"],
                "price": new_price,
            }
            print("--> Product updated successfully.")
        else:
            print("[!] Invalid product number.")
    except ValueError:
        print("[!] Invalid input.")


def remove_product():
    """Remove a product using pop()."""
    view_products_admin()
    if not product_list:
        return

    try:
        idx = int(input("Enter product number to remove: ")) - 1
        if 0 <= idx < len(product_list):
            # Remove using pop()
            removed_item = product_list.pop(idx)
            print(f"--> Removed '{removed_item['name']}' from product list.")
        else:
            print("[!] Invalid product number.")
    except ValueError:
        print("[!] Invalid input.")


def view_users():
    """View all registered users."""
    if not user_list:
        print("\n[!] No registered users.")
        return
    print("\n--- Registered Users ---")
    for i in range(len(user_list)):
        print(f"[{i + 1}] {user_list[i]}")


def admin_menu():
    while True:
        print("\n================ ADMIN MENU ================")
        print("1. Add Product")
        print("2. Update Product")
        print("3. Remove Product")
        print("4. View Products")
        print("5. View Users")
        print("6. Exit to Main Menu")
        choice = input("Select an option (1-6): ").strip()

        if choice == "1":
            add_product()
        elif choice == "2":
            update_product()
        elif choice == "3":
            remove_product()
        elif choice == "4":
            view_products_admin()
        elif choice == "5":
            view_users()
        elif choice == "6":
            break
        else:
            print("[!] Invalid option. Please select 1-6.")


# ==========================================
# USER SECTION
# ==========================================
def view_products_user():
    """View all available products."""
    if not product_list:
        print("\n[!] Store is empty right now.")
        return
    print("\n--- Products for Sale ---")
    for i in range(len(product_list)):
        prod = product_list[i]
        print(f"[{i + 1}] {prod['name']} - ₹{prod['price']:.2f}")


def add_to_cart():
    """Add product to cart using append()."""
    view_products_user()
    if not product_list:
        return

    try:
        idx = int(input("Enter product number to add to cart: ")) - 1
        if 0 <= idx < len(product_list):
            cart_list.append(product_list[idx])
            print(f"--> Added '{product_list[idx]['name']}' to cart.")
        else:
            print("[!] Invalid product number.")
    except ValueError:
        print("[!] Invalid input.")


def remove_from_cart():
    """Remove item from cart using pop()."""
    view_cart()
    if not cart_list:
        return

    try:
        idx = int(input("Enter cart item number to remove: ")) - 1
        if 0 <= idx < len(cart_list):
            removed_item = cart_list.pop(idx)
            print(f"--> Removed '{removed_item['name']}' from cart.")
        else:
            print("[!] Invalid cart item number.")
    except ValueError:
        print("[!] Invalid input.")


def view_cart():
    """View all items currently in cart."""
    if not cart_list:
        print("\n[!] Your cart is empty.")
        return
    print("\n--- Your Cart ---")
    total = 0.0
    for i in range(len(cart_list)):
        item = cart_list[i]
        print(f"[{i + 1}] {item['name']} - ₹{item['price']:.2f}")
        total += item["price"]
    print(f"Total Amount: ₹{total:.2f}")


def checkout():
    """Place order and clear cart."""
    global cart_list
    if not cart_list:
        print("\n[!] Cart is empty. Add products before checkout.")
        return

    view_cart()
    confirm = input("Confirm order? (y/n): ").strip().lower()
    if confirm == "y":
        order_list.append(list(cart_list))
        cart_list.clear()
        print("--> Order placed successfully! Cart has been cleared.")
    else:
        print("--> Checkout canceled.")


def user_menu():
    while True:
        print("\n================ USER MENU ================")
        print("1. View Products")
        print("2. Add to Cart")
        print("3. Remove from Cart")
        print("4. View Cart")
        print("5. Checkout")
        print("6. Exit to Main Menu")
        choice = input("Select an option (1-6): ").strip()

        if choice == "1":
            view_products_user()
        elif choice == "2":
            add_to_cart()
        elif choice == "3":
            remove_from_cart()
        elif choice == "4":
            view_cart()
        elif choice == "5":
            checkout()
        elif choice == "6":
            break
        else:
            print("[!] Invalid option. Please select 1-6.")


# ==========================================
# MAIN FLOW (ROLE SELECTION)
# ==========================================
def main():
    while True:
        print("\n===========================================")
        print("        SHOPPING CART SYSTEM               ")
        print("===========================================")
        print("1. Admin")
        print("2. User")
        print("3. Exit System")
        role = input("Select your role (1-3): ").strip()

        if role == "1":
            admin_menu()
        elif role == "2":
            user_menu()
        elif role == "3":
            print("\nThank you for using the Shopping Cart System. Goodbye!")
            break
        else:
            print("[!] Invalid selection. Please enter 1, 2, or 3.")


if __name__ == "__main__":
    main()